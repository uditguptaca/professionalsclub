# Copy to .env.local and fill in from the Neon Console.
# Next.js reads env files at startup, so restart `npm run dev` after editing.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon Console -> your project -> Connection string (use the POOLED one).
#
# This is a server-only secret. It is NOT prefixed NEXT_PUBLIC_, so it never
# reaches the browser — and it must stay that way. The browser has no database
# access at all in this app; it calls Server Actions, which call the repositories
# in src/server/repos/.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require

# ---------------------------------------------------------------------------
# Neon Auth (Managed Better Auth)
# ---------------------------------------------------------------------------
# Neon Console -> Auth -> Configuration.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth

# Signs the session cookie. Minimum 32 characters; generate a fresh random one
# per environment and never reuse it. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEON_AUTH_COOKIE_SECRET=<at-least-32-random-characters>

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Set to the string "false" to hide the matrimony module across the site.
NEXT_PUBLIC_FEATURE_MATRIMONY=true

# ---------------------------------------------------------------------------
# Community media (Vercel Blob)
# ---------------------------------------------------------------------------
# Vercel dashboard -> Storage -> Create Blob store -> copy the token.
# Without it, image/video upload works only in local dev (files go to
# public/uploads). Server-only secret — never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=<from Vercel Storage>

# ---------------------------------------------------------------------------
# Company referrals (0013)
# ---------------------------------------------------------------------------

# Transactional email. Without this the referral flow still works end to end:
# mail is queued in email_outbox and logged to the server console instead of
# being sent. Set it, plus the SPF/DKIM records Resend gives you for the
# sending domain, to make mail real.
RESEND_API_KEY=
EMAIL_FROM="Professionals Club <noreply@professionalsclub.ca>"

# Used to build links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authenticates the scheduled job refresh at /api/jobs/refresh. Vercel sends it
# as `Authorization: Bearer $CRON_SECRET`. If this is unset the route refuses
# every request rather than running open.
CRON_SECRET=

# Optional: Adzuna's free developer tier, used only by companies whose
# source_kind is 'adzuna'. Everything else needs no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
